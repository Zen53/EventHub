NODE_ENV=development
PORT=3001

# Your local Postgres: postgres://<user>:<password>@localhost:5432/<db>. Set real values in .env (never committed).
DATABASE_URL=postgres://user:change-me@localhost:5432/eventhub

# Signs the access tokens (HS256), at least 32 characters. Generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-secret-of-at-least-32-chars

# SMTP server that sends the emails. In development, Mailpit captures them: smtp://localhost:1052 (inbox on http://localhost:8052).
# With credentials: smtp://user:pass@host:587, or smtps://user:pass@host:465 (user and password percent-encoded).
SMTP_URL=smtp://localhost:1052

# Optional. STARTTLS is required by default, except on localhost. Set to "opportunistic" for a trusted relay without TLS on another host (Mailpit in Docker Compose).
# SMTP_STARTTLS=opportunistic

# Default sender of the emails.
MAIL_FROM=EventHub <no-reply@eventhub.local>

# Optional, 0 by default. Number of reverse proxies in front of the API (the Next.js front that relays the calls counts as one).
# The rate limit reads the client IP address from X-Forwarded-For only through that many proxies. Keep 0 when clients reach the API directly.
# TRUSTED_PROXY_HOPS=1

# Optional in development, where it defaults to http://localhost:3000. Required otherwise.
# Public address of the front, without a path. The links sent by email point to it, for example <WEB_URL>/reset-password?token=...
WEB_URL=http://localhost:3000
