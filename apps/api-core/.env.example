NODE_ENV=development
PORT=3000

# Your local Postgres: postgres://<user>:<password>@localhost:5432/<db>. Set real values in .env (never committed).
DATABASE_URL=postgres://user:change-me@localhost:5432/eventhub

# Signs the access tokens (HS256), at least 32 characters. Generate a real one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
