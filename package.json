{
  "name": "eventhub",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm -r build",
    "build:schemas": "pnpm --filter @eventhub/schemas build",
    "dev:schemas": "pnpm --filter @eventhub/schemas dev",
    "start:api": "pnpm --filter @eventhub/api-core start:dev",
    "start:web": "pnpm --filter @eventhub/web dev",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @eventhub/api-core test",
    "test:schemas": "pnpm --filter @eventhub/schemas test",
    "lint": "pnpm -r lint",
    "lint:api": "pnpm --filter @eventhub/api-core lint",
    "lint:web": "pnpm --filter @eventhub/web lint",
    "typecheck": "pnpm -r typecheck",
    "typecheck:api": "pnpm --filter @eventhub/api-core typecheck",
    "typecheck:web": "pnpm --filter @eventhub/web typecheck",
    "format:check:api": "pnpm --filter @eventhub/api-core format:check"
  }
}
